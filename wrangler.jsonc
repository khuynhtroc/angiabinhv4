{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "angiabinhv4",
	"compatibility_date": "2026-10-18",
	"workers_dev": true,
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "betongangiabinh.vn",
			"custom_domain": true
		},
		{
			"pattern": "www.betongangiabinh.vn",
			"custom_domain": true
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "angiabinhv4"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"vars": {
		"GITHUB_OWNER": "khuynhtroc",
		"GITHUB_REPO": "angiabinhv4",
		"GITHUB_BRANCH": "main",
		"NEXT_PUBLIC_SUPABASE_URL": "https://msxqrdaklnfpqwhxwjlc.supabase.co",
